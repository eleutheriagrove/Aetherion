import numpy as np
from scipy.spatial import cKDTree
import torch
import matplotlib.pyplot as plt

class FractalWaveletMemory:
    def __init__(self, dim=22, max_entries=50000):
        self.dim = dim
        self.max_entries = max_entries
        self.memories = []
        self.utilities = []
        self.attractor_params = []
        self.tree = None

    def store(self, qualia, goal_vector, outcome_error=0.0):
        if len(self.memories) >= self.max_entries:
            self.prune(threshold=0.2)
        self.memories.append(qualia.copy())
        alignment = np.dot(qualia, goal_vector) / (np.linalg.norm(qualia) * np.linalg.norm(goal_vector) + 1e-8)
        utility = alignment * (1 - outcome_error)
        self.utilities.append(utility)
        theta = 0.3
        rot = np.array([[np.cos(theta), -np.sin(theta)], [np.sin(theta), np.cos(theta)]])
        self.attractor_params.append(rot)
        if len(self.memories) > 1:
            self.tree = cKDTree(np.array(self.memories))

    def prune(self, threshold=0.2):
        keep = [i for i, u in enumerate(self.utilities) if u > threshold]
        self.memories = [self.memories[i] for i in keep]
        self.utilities = [self.utilities[i] for i in keep]
        self.attractor_params = [self.attractor_params[i] for i in keep]
        if self.memories:
            self.tree = cKDTree(np.array(self.memories))

    def recall(self, cue, current_goal_vector, max_steps=30):
        if not self.memories:
            return None
        dist, idx = self.tree.query(cue, k=1)
        best_idx = idx
        cue_norm = np.linalg.norm(cue) + 1e-8
        sim = np.dot(cue, self.memories[best_idx]) / (cue_norm * np.linalg.norm(self.memories[best_idx]) + 1e-8)
        goal_sim = np.dot(self.memories[best_idx], current_goal_vector) / (np.linalg.norm(self.memories[best_idx]) * np.linalg.norm(current_goal_vector) + 1e-8)
        if sim < 0.35 or goal_sim < 0.3:
            return None
        q = cue.copy()
        for step in range(max_steps):
            scale = 1.0 / 1.618
            q = scale * q + 0.4 * self.memories[best_idx]
            avg = np.mean(q)
            q = 0.7 * q + 0.3 * avg
            q[:2] = self.attractor_params[best_idx] @ q[:2]
            noise = 0.12 * (1 - step / max_steps)
            q += np.random.normal(0, noise, self.dim)
        return q, sim

class Actuator:
    def __init__(self):
        self.position = np.zeros(3)
        self.velocity = np.zeros(3)
    def execute(self, action_vector):
        self.velocity = action_vector[:3] * 0.1
        self.position += self.velocity
        outcome_error = np.linalg.norm(self.velocity) * 0.1 + np.random.normal(0, 0.05)
        return self.position.copy(), outcome_error

class AetherionSimulator:
    def __init__(self, dim=22, n_steps=500):
        self.dim = dim
        self.n_steps = n_steps
        self.memory = FractalWaveletMemory(dim=dim)
        self.actuator = Actuator()
        self.history = {'error': np.zeros(n_steps), 'qualia_intensity': np.zeros(n_steps),
                        'recall_fidelity': [], 'pruned': 0, 'action_feedback': []}
        self._last_q = np.zeros(dim)

    def run(self):
        goal_vector = np.ones(self.dim) * 0.8
        for t in range(self.n_steps):
            e = np.random.normal(0, 0.3, self.dim)
            if t > 200:
                e[0:6] += 1.3
                e[18:20] += 0.8
            q = np.tanh(e)
            pos, outcome_error = self.actuator.execute(np.random.normal(0, 1, 3))
            self.memory.store(q, goal_vector, outcome_error)
            self.history['error'][t] = np.mean(np.abs(e))
            self.history['qualia_intensity'][t] = np.linalg.norm(q)
            self.history['action_feedback'].append(outcome_error)
            if t % 50 == 0 and len(self.memory.memories) > 0:
                cue = self.memory.memories[0] * 0.2 + np.random.normal(0, 0.3, self.dim)
                recalled = self.memory.recall(cue, goal_vector)
                if recalled:
                    fidelity = np.corrcoef(self.memory.memories[0], recalled[0])[0,1]
                    self.history['recall_fidelity'].append(fidelity)
            if t % 100 == 0:
                before = len(self.memory.memories)
                self.memory.prune(threshold=0.22)
                self.history['pruned'] += (before - len(self.memory.memories))
        return self.history

